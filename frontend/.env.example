# Copy to frontend/.env.local (local) or set in Vercel > Settings > Environment Variables.
# Never commit real values.

# Base URL of the FastAPI backend, no trailing slash.
#   Local:  http://localhost:8000
#   Vercel: https://<your-render-service>.onrender.com
# Next.js proxies /api/* to this URL, so the browser only talks to the frontend origin.
API_URL=
