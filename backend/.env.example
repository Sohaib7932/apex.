# Copy to backend/.env (local) or set in Render > Environment. Never commit real values.
ENVIRONMENT=development
# Neon pooled connection string (host contains "-pooler"), used by the API.
DATABASE_URL=
# Neon direct connection string, used by Alembic migrations.
DATABASE_URL_UNPOOLED=
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Stripe test mode keys (Dashboard > Developers > API keys / Webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public URL of the frontend, used for Stripe success/cancel redirects and CORS.
#   Local:  http://localhost:3000
#   Prod:   https://<your-app>.vercel.app
FRONTEND_URL=
# Optional: comma-separated extra CORS origins (defaults to FRONTEND_URL).
CORS_ORIGINS=
