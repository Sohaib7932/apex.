# Copy to backend/.env and fill in. Never commit real values.
ENVIRONMENT=development
# Neon pooled connection string (host contains "-pooler"), used by the API.
DATABASE_URL=
# Neon direct connection string, used by Alembic migrations.
DATABASE_URL_UNPOOLED=
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
